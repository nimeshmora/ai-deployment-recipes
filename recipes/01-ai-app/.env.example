# Copy to .env. No real secrets belong here or in Git.
MODEL_MODE=mock
# Live mode: base URL including the API version path (usually /v1), no trailing endpoint.
MODEL_BASE_URL=
MODEL_NAME=
# Permit HTTP only for an explicitly trusted local/private model endpoint.
ALLOW_HTTP_UPSTREAM=false
MAX_INFLIGHT=4
REQUESTS_PER_MINUTE=30
UPSTREAM_DEADLINE_SECONDS=30
MAX_OUTPUT_TOKENS=256
